# Never use a production URL or key in local/staging configuration.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=your-project-ref

# New order checkout requires deployed Edge functions + audited additive migrations.
VITE_TURNSTILE_SITE_KEY=
# Enable only in isolated staging after Wompi sandbox acceptance.
VITE_ONLINE_PAYMENTS_ENABLED=false
