# Edge secrets ONLY. Never prefix with VITE_ or commit actual values.
APP_ORIGIN=http://localhost:8080
# Verify ingress overwrites this header; the nearest proxy value is used.
RATE_LIMIT_TRUSTED_HEADER=x-forwarded-for
RATE_LIMIT_SECRET=
TURNSTILE_SECRET_KEY=
ONLINE_PAYMENTS_ENABLED=false
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_REFUNDS_ENABLED=false
WOMPI_REFUND_METHODS=CARD
# Verify hosted merchant settings expose only refund-supported methods.
WOMPI_HOSTED_METHODS_VERIFIED=false
# Verify these provider lookup contracts with sandbox credentials before enabling.
WOMPI_REFERENCE_LOOKUP_VERIFIED=false
WOMPI_REFUND_LOOKUP_VERIFIED=false
RECONCILIATION_SECRET=
MONITORING_URL=
MONITORING_TOKEN=
# Kill switch for NEW orders (quote/create). Unset = enabled; the exact string "false" returns 503 orders_disabled.
# Tracking, admin actions, webhook and reconciliation keep working. Wompi stays off unless ONLINE_PAYMENTS_ENABLED=true.
ORDERS_ENABLED=true
